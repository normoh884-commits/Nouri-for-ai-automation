    {
      "parameters": {
        "jsCode": "for (const item of $input.all()) {\n  const data = item.json;\n  let errors = [];\n  \n  // 1. Name validation (at least 2 parts, each part >= 3 characters)\n  const fullName = (data[\"Full name\"] || data[\"name\"] || \"\").trim();\n  const nameParts = fullName.split(/\\s+/);\n  if (nameParts.length < 2) {\n    errors.push(\"Please enter your full name (first and last name, letters only).\");\n  } else {\n    for (const part of nameParts) {\n      if (part.length < 3) {\n        errors.push(`Name part \"${part}\" is too short (must be at least 3 characters).`);\n      }\n    }\n  }\n\n  // 2. Email validation (valid email format)\n  const email = (data[\"Email\"] || data[\"email\"] || \"\").trim();\n  const emailRegex = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\n  if (!emailRegex.test(email)) {\n    errors.push(\"Please enter a valid email address.\");\n  }\n\n  // 3. Dropdown validation (must match allowed options)\n  const allowedPositions = [\"Ai automation\", \"Frontend Developer\", \"Backend Developer\", \"AI Automation Engineer (Junior)\"];\n  const position = (data[\"Postition\"] || data[\"position\"] || \"\").trim();\n  if (!allowedPositions.includes(position)) {\n    errors.push(\"Please select a valid position from the dropdown.\");\n  }\n\n  // 4. \"why do you want this job?\" / motivation field (less than 1500 characters)\n  const motivationText = data[\"why do you want this job?\"] || data[\"motivation\"] || \"\";\n  if (motivationText.length >= 1500) {\n    errors.push(\"The motivation field must be under 1500 characters.\");\n  }\n\n  // Build the exact output structure shown in the image\n  item.json = {\n    name: fullName,\n    email: email,\n    position: position,\n    motivation: motivationText,\n    valid: errors.length === 0,\n    errors: errors,\n    errorText: errors.length > 0 ? errors.map(err => `- ${err}`).join(\"\\n\") : \"\"\n  };\n}\n\nreturn $input.all();"
      },
